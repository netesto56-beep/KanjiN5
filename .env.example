# Скопируйте в .env и подставьте значения из Supabase → Project Settings → API.
# Достаточно одного набора имён: NEXT_PUBLIC_* или VITE_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Вариант с новыми ключами Supabase (publishable):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Вариант с префиксом Vite:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
